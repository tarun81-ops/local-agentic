# Leave API_TOKEN empty: the desktop app passes a fresh token each launch, and a backend
# started on its own generates one and prints it (also saved in the data folder).
API_TOKEN=
OLLAMA_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3-vl:2b-instruct
EMBEDDING_MODEL=granite-embedding:278m
# Extra folders to watch, comma-separated. Normally you add folders from the Index page.
WATCH_FOLDERS=

# "ollama" (default) or "openai" for an OpenAI-compatible server such as OpenVINO Model
# Server; then OLLAMA_BASE_URL points at it (see docs/OPENVINO.md).
LLM_PROVIDER=ollama
# RAM: unload the chat model after this many idle seconds (0 = never); skip embeddings
# while free RAM is below MIN_FREE_RAM_MB (those files get vectors on the next scan).
LLM_IDLE_UNLOAD_S=600
MIN_FREE_RAM_MB=1200
# Describe images with the vision model while indexing (slow on CPU). OCR needs rapidocr.
CAPTION_IMAGES=false
