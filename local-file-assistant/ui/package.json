{
  "name": "local-file-assistant-ui",
  "version": "0.2.0",
  "private": true,
  "description": "Local file assistant",
  "author": "tarun",
  "main": "electron/main.js",
  "scripts": {
    "start": "npm run build:web && electron .",
    "dev": "concurrently -k -n vite,electron \"vite\" \"electron . --dev\"",
    "build:web": "vite build",
    "build:backend": "powershell -ExecutionPolicy Bypass -File ../scripts/build-backend.ps1",
    "build": "npm run build:web && npm run build:backend && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.localfileassistant.app",
    "productName": "Local File Assistant",
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/lfa-backend",
        "to": "backend"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "chart.js": "^4.5.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.1"
  }
}
