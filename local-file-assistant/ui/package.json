{
  "name": "local-file-assistant-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Local file assistant",
  "author": "tarun",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently -k -n vite,electron \"vite --strictPort\" \"electron . --dev\"",
    "build:web": "vite build --base ./",
    "build": "npm run build:web && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.localfileassistant.app",
    "productName": "Local File Assistant",
    "files": ["electron/**/*", "dist/**/*", "package.json"],
    "directories": { "output": "release" }
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.1"
  }
}
